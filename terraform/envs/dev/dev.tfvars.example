# Copy to dev.tfvars (Git ignores it) and fill in your own values:
#   cp dev.tfvars.example dev.tfvars

environment = "dev"
location    = "southafricanorth"

# Standard_B1s is blocked on some student subscriptions. Check yours:
#   az vm list-skus --location southafricanorth --size Standard_B --all -o table
vm_size = "Standard_B2ats_v2"

ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Teammates' public keys (the contents of their .pub files), so they can SSH in too.
extra_ssh_public_keys = [
  # "ssh-rsa AAAA... phillip",
]

# Public IPs allowed to SSH in, one per team member, each with /32.
# Find yours with: curl ifconfig.me
admin_cidrs = ["203.0.113.10/32"]
